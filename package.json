{
  "name": "atelier-design-studio",
  "productName": "Atelier",
  "version": "1.0.0",
  "description": "A free, open-source design studio for posters, social posts, presentations, documents, whiteboards, videos and websites. Runs fully on your device.",
  "main": "main.js",
  "author": "Atelier contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "npx --yes http-server app -p 8080 -c-1",
    "test": "node tests/smoke.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.atelier.designstudio",
    "productName": "Atelier",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*", "build/icon.png", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.graphics-design", "icon": "build/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Graphics", "icon": "build/icon.png" },
    "publish": null
  }
}
